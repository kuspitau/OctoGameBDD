@echo off
setlocal EnableExtensions
title OctoGameDB P4-T04 - Local Level-2 Validation

set "PROJECT_ROOT="
if exist "%~dp0pyproject.toml" if exist "%~dp0scripts\validate_p4_t04.py" set "PROJECT_ROOT=%~dp0"
if not defined PROJECT_ROOT if exist "%CD%\pyproject.toml" if exist "%CD%\scripts\validate_p4_t04.py" set "PROJECT_ROOT=%CD%\"
if not defined PROJECT_ROOT (
  echo [FAIL] OctoGameDB project root was not found.
  echo [INFO] Put this BAT in the project root, then double-click it, or run it from that root.
  pause
  exit /b 2
)
cd /d "%PROJECT_ROOT%"

for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"`) do set "STAMP=%%T"
if not defined STAMP set "STAMP=manual_%RANDOM%"
if not exist "data\generated" mkdir "data\generated" >nul 2>&1
set "RUN_DIR=data\generated\p4_t04_local_validation_%STAMP%"
if exist "%RUN_DIR%" set "RUN_DIR=%RUN_DIR%_%RANDOM%"
mkdir "%RUN_DIR%" >nul 2>&1
if errorlevel 1 (
  echo [FAIL] Could not create validation output directory: %RUN_DIR%
  pause
  exit /b 2
)

for %%I in ("%RUN_DIR%") do set "P4T04_RUN_DIR=%%~fI"
set "P4T04_LOG=%P4T04_RUN_DIR%\p4_t04_local_validation.log"
set "P4T04_HELPER=%P4T04_RUN_DIR%\_p4_t04_validation_helper.py"
set "P4T04_B64=%P4T04_RUN_DIR%\_p4_t04_validation_helper.b64"
set "P4T04_VALID_SOURCE=%P4T04_RUN_DIR%\validation_source_m12.sqlite3"
set "P4T04_VALID_WORK=%P4T04_RUN_DIR%\validation_work_m13.sqlite3"
set "P4T04_VALID_JSON=%P4T04_RUN_DIR%\validation.json"
set "P4T04_PROMO_CANON=%P4T04_RUN_DIR%\promotion_simulation_canonical.sqlite3"
set "P4T04_PROMO_BACKUP=%P4T04_RUN_DIR%\promotion_simulation_backup_m12.sqlite3"
set "P4T04_PROMO_JSON=%P4T04_RUN_DIR%\promotion_simulation.json"

> "%P4T04_LOG%" echo OctoGameDB P4-T04 local Level-2 validation
>>"%P4T04_LOG%" echo Started: %DATE% %TIME%
>>"%P4T04_LOG%" echo Project root: %CD%

call :log "[INFO] P4-T04 remaining local validation started."
call :log "[INFO] Output directory: %P4T04_RUN_DIR%"
call :log "[INFO] Main canonical and rollback databases will NOT be promoted or modified."
call :log "[INFO] Repository pytest/Ruff/compileall gates are intentionally not repeated."

> "%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
>>"%P4T04_B64%" echo 
powershell -NoProfile -ExecutionPolicy Bypass -Command "$raw=(Get-Content -Raw -LiteralPath $env:P4T04_B64) -replace '\s',''; [IO.File]::WriteAllBytes($env:P4T04_HELPER,[Convert]::FromBase64String($raw))" >>"%P4T04_LOG%" 2>&1
if errorlevel 1 (
  call :log "[FAIL] Could not generate temporary validation helper."
  set "FINAL_RC=2"
  goto :finish
)
del /q "%P4T04_B64%" >nul 2>&1

call :run_helper precheck "Preflight: baseline, configured real sources, revisions, disposable snapshots"
if errorlevel 1 (set "FINAL_RC=2" & goto :finish)

call :log "[INFO] Running non-destructive full-data P4-T04 validation on the disposable migration-12 snapshot."
powershell -NoProfile -ExecutionPolicy Bypass -Command "& python scripts/validate_p4_t04.py validate --source-db $env:P4T04_VALID_SOURCE --work-db $env:P4T04_VALID_WORK --config config.local.toml --json-out $env:P4T04_VALID_JSON 2>&1 | Tee-Object -FilePath $env:P4T04_LOG -Append; exit $LASTEXITCODE"
if errorlevel 1 (
  call :log "[FAIL] Non-destructive P4-T04 full-data validation failed."
  set "FINAL_RC=2"
  goto :finish
)
call :log "[PASS] Non-destructive full-data validator completed."

call :run_helper check-validation "Checking Level-2 invariants and emitting discovery diagnostics/samples"
if errorlevel 1 (set "FINAL_RC=2" & goto :finish)

call :log "[INFO] Simulating the guarded D-029 promotion on a SECOND disposable copy only."
powershell -NoProfile -ExecutionPolicy Bypass -Command "& python scripts/validate_p4_t04.py promote --canonical-db $env:P4T04_PROMO_CANON --backup-db $env:P4T04_PROMO_BACKUP --config config.local.toml --validation-json $env:P4T04_VALID_JSON --json-out $env:P4T04_PROMO_JSON 2>&1 | Tee-Object -FilePath $env:P4T04_LOG -Append; exit $LASTEXITCODE"
if errorlevel 1 (
  call :log "[FAIL] Guarded-promotion simulation failed."
  set "FINAL_RC=2"
  goto :finish
)
call :log "[PASS] Guarded-promotion simulation completed on the disposable copy."

call :run_helper check-promotion "Checking guarded-promotion simulation invariants and count parity"
if errorlevel 1 (set "FINAL_RC=2" & goto :finish)

call :run_helper postcheck "Final non-destructive check: main DB hashes unchanged and disposable results identical"
if errorlevel 1 (set "FINAL_RC=2" & goto :finish)

set "FINAL_RC=0"
goto :finish

:run_helper
set "P4T04_MODE=%~1"
set "P4T04_DESC=%~2"
call :log "[INFO] %P4T04_DESC%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "& python $env:P4T04_HELPER $env:P4T04_MODE $env:P4T04_RUN_DIR 2>&1 | Tee-Object -FilePath $env:P4T04_LOG -Append; exit $LASTEXITCODE"
if errorlevel 1 (
  call :log "[FAIL] %P4T04_DESC%"
  exit /b 2
)
call :log "[PASS] %P4T04_DESC%"
exit /b 0

:log
echo %~1
>>"%P4T04_LOG%" echo %~1
exit /b 0

:finish
if exist "%P4T04_HELPER%" del /q "%P4T04_HELPER%" >nul 2>&1
if exist "%P4T04_B64%" del /q "%P4T04_B64%" >nul 2>&1
if not defined FINAL_RC set "FINAL_RC=2"
if "%FINAL_RC%"=="0" (
  call :log "[PASS] COMPLETE AUTOMATED P4-T04 LOCAL VALIDATION PASSED."
  call :log "[PASS] Main canonical/rollback data remained unchanged; guarded promotion was tested only on disposable copies."
  call :log "[INFO] Discovery diagnostics and representative samples are recorded above for handoff review."
) else (
  call :log "[FAIL] P4-T04 LOCAL VALIDATION FAILED. Do not promote the canonical database."
)
call :log "[INFO] Finished: %DATE% %TIME%"
echo.
echo ================================================================
if "%FINAL_RC%"=="0" (echo [PASS] P4-T04 local validation succeeded.) else (echo [FAIL] P4-T04 local validation failed.)
echo [INFO] Log to return: %P4T04_LOG%
echo [INFO] Evidence directory: %P4T04_RUN_DIR%
echo ================================================================
echo.
pause
exit /b %FINAL_RC%
